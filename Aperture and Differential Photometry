"""Let's organize our flux data. We have to say the flux of the science object and the fluxes of the comparisons, as well as their due errors."""

sci_flux = np.array([i['flux'][73] for i in ap])
sci_flux_error = np.array([i['flux_error'][73] for i in ap])

#comparisons
flux_C2 = np.array([i['flux'][indx[0]] for i in ap])
flux_error_C2 = np.array([i['flux_error'][indx[0]] for i in ap])

flux_C3 = np.array([i['flux'][indx[1]] for i in ap])
flux_error_C3 = np.array([i['flux_error'][indx[1]] for i in ap])

flux_C4 = np.array([i['flux'][indx[2]] for i in ap])
