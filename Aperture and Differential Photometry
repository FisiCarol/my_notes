flux_C7 = np.array([i['flux'][indx[5]] for i in ap])
flux_error_C7 = np.array([i['flux_error'][indx[5]] for i in ap])

"""To considerate the error propagation, we will use the 'qfloat' function for each flux and thus we can make the ratio of the science object with the comparisons."""

#qfolat
q_sci_flux = qfloat(value=sci_flux, uncertainty=sci_flux_error)
q_flux_C2 = qfloat(value=flux_C2, uncertainty=flux_error_C2)
q_flux_C3 = qfloat(value=flux_C3, uncertainty=flux_error_C3)
q_flux_C4 = qfloat(value=flux_C4, uncertainty=flux_error_C4)
q_flux_C5 = qfloat(value=flux_C5, uncertainty=flux_error_C5)
q_flux_C6 = qfloat(value=flux_C6, uncertainty=flux_error_C6)
q_flux_C7 = qfloat(value=flux_C7, uncertainty=flux_error_C7)

#error propagation
q_C2 = q_sci_flux/q_flux_C2
q_C3 = q_sci_flux/q_flux_C3
q_C4 = q_sci_flux/q_flux_C4
q_C5 = q_sci_flux/q_flux_C5
q_C6 = q_sci_flux/q_flux_C6
q_C7 = q_sci_flux/q_flux_C7

#sum
q_sum = (q_flux_C2 + q_flux_C3 + q_flux_C4 + q_flux_C5 + q_flux_C6 + q_flux_C7)

sci_sum = q_sci_flux/q_sum

"""We have to normalize by the median"""

